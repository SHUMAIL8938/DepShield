{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/__clerk/:path*",
      "destination": "https://depshield-app.vercel.app/__clerk/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}